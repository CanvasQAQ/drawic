{
  "name": "drawic",
  "version": "0.2.0",
  "description": "A local-first analog and mixed-signal schematic editor.",
  "main": "dist/main/main.js",
  "author": {
    "name": "CanvasQAQ",
    "email": "CanvasQAQ@users.noreply.github.com"
  },
  "homepage": "https://github.com/CanvasQAQ/drawic",
  "repository": {
    "type": "git",
    "url": "https://github.com/CanvasQAQ/drawic.git"
  },
  "desktopName": "drawic.desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:node": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build:devices": "node scripts/build-device-library.mjs",
    "build": "npm run clean && npm run build:node && npm run build:renderer",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "verify:offline": "node scripts/verify-offline.mjs",
    "verify:clean-room": "node scripts/verify-clean-room.mjs",
    "verify:release": "node scripts/verify-release-assets.mjs",
    "checksums": "node scripts/generate-checksums.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.canvasqaq.drawic",
    "productName": "Drawic",
    "copyright": "Copyright © 2026 CanvasQAQ",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "README.md",
      "CLEAN_ROOM.md",
      "PROVENANCE.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "fileAssociations": [
      {
        "ext": "drawic.json",
        "name": "Drawic Project",
        "description": "Drawic schematic project",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Drawic-${version}-Unsigned-Preview-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Drawic-${version}-Unsigned-Preview-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Drawic-${version}-Unsigned-Preview-windows-${arch}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Drawic-${version}-Unsigned-Preview-macos-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Drawic-${version}-Unsigned-Preview-macos-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "Drawic-${version}-Unsigned-Preview-linux-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "Drawic-${version}-Unsigned-Preview-linux-x64.AppImage"
    },
    "deb": {
      "artifactName": "Drawic-${version}-Unsigned-Preview-linux-x64.deb"
    }
  }
}
